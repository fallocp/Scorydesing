# Supabase (shared with MarketXending)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OpenAI (for image generation in renderer)
OPENAI_API_KEY=sk-...

# Render Service (local: run `cd renderer && npm run render-server`)
# For cloud deployment, set to your Fly.io/Railway URL
RENDER_SERVICE_URL=http://localhost:3333/render
# Token for authenticating render requests (leave empty for local dev)
RENDER_SERVICE_TOKEN=
