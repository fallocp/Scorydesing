# Isolated experiment only. Copy to .env.desaing.local; do not copy production keys.
# This file is an operator checklist. The app and worker do not load it automatically.
DESAING_SERVER_ENABLED=false
DESAING_LIVE_EXECUTION_ENABLED=false
DESAING_TARGET_SUPABASE_URL=
DESAING_TARGET_SUPABASE_ANON_KEY=
# The service role credential is operator-only and is never listed in .example files
# (docs/MIGRATION_SCOPE.md §2.7). scripts/desaing/preflight.mjs reads it from .env.desaing.local.
DESAING_ALLOWED_ORIGINS=
OPENAI_API_KEY=
# Reasoning/vision model for Responses. Image model remains part of the stored operation.
DESAING_RESPONSES_MODEL=
# Bound the text/reasoning response; image-tool usage is accounted separately.
DESAING_RESPONSES_MAX_OUTPUT_TOKENS=2048
DESAING_PILOT_BUSINESS_ID=
DESAING_PILOT_ACTOR_ID=
DESAING_PILOT_POLICY_ID=
# Positive integers, in millionths of one US dollar. No budget is inferred from API access.
DESAING_APPROVED_BUDGET_MICRO_USD=0
DESAING_RESERVATION_PER_OUTPUT_MICRO_USD=0
DESAING_PILOT_MAX_IMAGE_OUTPUTS=0
DESAING_PILOT_EXPIRES_AT=
