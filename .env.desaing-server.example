# Server secrets/configuration only. Never prefix these settings with VITE_.
# Deploying the JWT endpoint does not by itself enable paid generation.
DESAING_SERVER_ENABLED=false
DESAING_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DESAING_UI_GENERATION_ENABLED=false
# The server selects the executor; product modes never choose an API.
DESAING_UI_EXECUTOR=image_api
# Explicit UTC Unix milliseconds for this UI window; 0 keeps generation closed.
DESAING_UI_EXPIRES_AT_MS=0
# Text planning uses its own explicit gate and the same total USD 5 budget.
# USD 0.25 reserved per request; text holds/accounting cannot exceed USD 1.
DESAING_EXPLORATION_ENABLED=false
DESAING_EXPLORATION_EXPIRES_AT_MS=0
# Administrative prompt drafts/publication, also gated by an explicit database grant.
DESAING_PROMPT_ADMIN_ENABLED=false
# Exact owner-approved development scope, shared with the administrative pilot.
DESAING_PILOT_BUSINESS_ID=
DESAING_PILOT_ACTOR_ID=
DESAING_PILOT_POLICY_ID=
DESAING_PILOT_SUPABASE_ORIGIN=
# OPENAI_API_KEY and Supabase credentials are configured separately on the server.
# This pilot requires the existing USD 5 / four outputs / USD 1 reservation policy.
