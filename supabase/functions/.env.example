# Edge Functions secrets for the LOCAL Supabase (ADR-0006). Names only: values go in
# supabase/functions/.env (git-ignored), which the local edge runtime loads on `npm run supabase:start`.
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY and SUPABASE_DB_URL are injected by the
# edge runtime: do not put them here. Never copy values from the shared project.

# --- Provider key --------------------------------------------------------------------------------
# OpenAI. Used by: adapt-channel, analyze-brand-assets, analyze-image-reference, brand-onboarding,
# compliance-wizard, desaing-pilot, desaing-server, evolution-summary, generate-carousel-plan,
# generate-carousel-script, generate-copy-v2, generate-design-copy, generate-design-html,
# generate-design-image, generate-fx-daily, generate-ideas, generate-news-plan, generate-news-visuals,
# generate-strategy, generate-variants, interpret-feedback, pipeline-orchestrator, refine-branch,
# refine-image-prompt, scrape-brand-presence, suggest-copy, suggest-image-ideas, translate-text,
# validate-claim. Every call costs money.
OPENAI_API_KEY=

# --- Public URL ----------------------------------------------------------------------------------
# generate-design-html: browser-reachable API URL for public Storage links (Brand logo). Locally the
# runtime's SUPABASE_URL is the internal Kong URL; when unset the function falls back to SUPABASE_URL.
SCORY_PUBLIC_SUPABASE_URL=

# --- desaing-server / desaing-state --------------------------------------------------------------
# Feature switches ('true' enables).
DESAING_SERVER_ENABLED=
DESAING_UI_GENERATION_ENABLED=
DESAING_EXPLORATION_ENABLED=
# desaing-server only.
DESAING_PROMPT_ADMIN_ENABLED=
# image_api (default) or responses_image.
DESAING_UI_EXECUTOR=
# Comma-separated browser origins allowed to call the functions.
DESAING_ALLOWED_ORIGINS=
# Must equal SUPABASE_URL as seen inside the edge runtime (also read by desaing-pilot).
DESAING_PILOT_SUPABASE_ORIGIN=

# --- desaing-pilot (administrative, off by default) -----------------------------------------------
DESAING_PILOT_ENABLED=
DESAING_PILOT_TOKEN=
DESAING_PILOT_BUSINESS_ID=
DESAING_PILOT_ACTOR_ID=
DESAING_PILOT_POLICY_ID=
DESAING_PILOT_EXPIRES_AT_MS=

# --- Optional overrides (unset = default in code) ------------------------------------------------
# generate-design-image: 'default' or 'editorial_v2' (code default: editorial_v2).
PHOTO_STYLE=
# generate-design-image: 'v1' or 'v2' (code default: v2).
MASTER_IMAGE_PROMPT_VERSION=
# generate-design-image: 'database' or 'code' (code default: code).
MASTER_IMAGE_PROMPT_SOURCE=
# generate-carousel-plan, generate-carousel-script, generate-copy-v2: 'database' or unset (code).
COPY_KIT_SOURCE=
# generate-design-html models (code default: gpt-5.4-mini; SLIDE_REVIEW_MODEL falls back to SLIDE_FIX_MODEL).
SLIDE_MODEL=
SLIDE_FIX_MODEL=
SLIDE_REVIEW_MODEL=
# suggest-copy (code default: gpt-4o).
COPY_MODEL=
# generate-copy-v2 (code default: gpt-5.4-mini).
COPY_V2_MODEL=
# translate-text (code default: gpt-4o).
TRANSLATE_MODEL=

# --- render-design-png ---------------------------------------------------------------------------
# PNG render service. Unset: the function answers 503 render_service_unavailable (same as shared).
RENDER_SERVICE_URL=
RENDER_SERVICE_TOKEN=
