# Vite mode "localsupabase" (npm run dev:local / build:local): the app against the LOCAL Supabase.
# Copy to .env.localsupabase (git-ignored). Names only; never put shared-project values here.
# Vite also loads .env in this mode, so the credential names below override it.

# Local API (supabase/config.toml [api] port) and the local anon key (npm run supabase:status).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Overrides of shared-project values that .env may carry (leave as below).
VITE_SUPABASE_PROJECT_ID=scorydesign
VITE_SUPABASE_PUBLISHABLE_KEY=
# Never set: a password in VITE_* ends up in the bundle. AuthGate shows the login form instead.
VITE_AUTH_EMAIL=
VITE_AUTH_PASSWORD=

# App flags ('true' enables).
VITE_DESAING_DESIGN_FROM_EXISTING=
VITE_DESAING_DESIGN_SCREEN=
VITE_DESAING_DECK_SYSTEM=
VITE_DESAING_ADD_SLIDE_NEW=
VITE_DESAING_SERVER_ENABLED=
VITE_DESAING_EXPLORATION_ENABLED=
VITE_DESAING_PROMPT_ADMIN_ENABLED=
